{
  "schema_version": 1,
  "stack_version": "2026.09.13.1",
  "components": {
    "honcho": {
      "purpose": "reasoning memory and cross-channel continuity",
      "integration": "native-hermes-memory-provider",
      "scope": "each-installation-distinct-workspace-and-ai-peer-with-explicit-owner-aliases",
      "setup_command": "hermes memory setup honcho",
      "documentation": "https://hermes-agent.nousresearch.com/docs/user-guide/features/honcho"
    },
    "latitude": {
      "purpose": "agent traces, failure discovery, evaluation, and fleet visibility",
      "observer": "plugins/latitude-observer",
      "otlp_endpoint": "https://ingest.latitude.so/v1/traces",
      "mcp_endpoint": "https://api.latitude.so/v1/mcp",
      "default_capture_mode": "metadata",
      "semantic_capture_mode": "sanitized",
      "scope": "per-profile-private-credentials-and-exporter",
      "documentation": "https://docs.latitude.so/telemetry/otel-exporter"
    },
    "a2a": {
      "purpose": "authenticated role-to-role requests and handoffs",
      "scope": "all-profiles",
      "authority_rule": "a2a-message-is-a-request-never-an-approval",
      "documentation": "https://hermes-agent.nousresearch.com/docs/user-guide/messaging/a2a"
    },
    "agentphone": {
      "integration": "hosted-mcp-and-hermes-platform-adapter",
      "scope": "each-explicitly-selected-installation-own-identity-number-and-credential",
      "default": "disabled"
    },
    "agentmail": {
      "integration": "hosted-mcp",
      "scope": "each-explicitly-selected-installation-own-inbox-and-credential",
      "default": "disabled"
    },
    "agentcard": {
      "integration": "hosted-mcp-test-key",
      "scope": "separate-explicit-selection",
      "default": "disabled",
      "initial_mode": "TEST",
      "spending_enabled": false
    }
  },
  "activation": {
    "automatic_on_repository_update": [
      "install-disabled-integration-code",
      "preserve-existing-secrets-oauth-identity-and-conversations"
    ],
    "requires_separate_owner_selection": [
      "honcho",
      "latitude",
      "agentphone",
      "agentmail",
      "agentcard",
      "other-optional-services"
    ]
  }
}
